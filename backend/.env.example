# ─── Server ───
PORT=8080

# ─── Database (PostgreSQL) ───
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_NAME=sdit_management
DB_PORT=5432

# ─── JWT Authentication ───
# Gunakan string acak yang panjang dan aman (minimal 32 karakter)
JWT_SECRET=your_jwt_secret_key_here_minimum_32_chars

# ─── Midtrans Payment Gateway ───
# Dapatkan dari dashboard Midtrans: https://dashboard.midtrans.com
MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# ─── WhatsApp Notification (Fonnte) ───
# Dapatkan dari dashboard Fonnte: https://fonnte.com
FONNTE_TOKEN=your_fonnte_token_here
